[Unit]
Description=Sakomplektetas furnituras iznemsanas stacija
After=network-online.target graphical.target
Wants=network-online.target graphical.target

[Service]
User=bsadmin
WorkingDirectory=/home/bsadmin/Desktop/furnituras_iznemsanas_stacija/furniture-station
ExecStart=/bin/bash /home/bsadmin/Desktop/furnituras_iznemsanas_stacija/furniture-station/start_app.sh
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/bsadmin/.Xauthority
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target

[Unit]
Description=Sakomplektetas furnituras iznemsanas stacija
After=network-online.target graphical.target
Wants=network-online.target graphical.target

[Service]
User=pi
WorkingDirectory=/home/pi/Desktop/furnituras_iznemsanas_stacija
ExecStart=/bin/bash /home/pi/Desktop/furnituras_iznemsanas_stacija/start_app.sh
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
